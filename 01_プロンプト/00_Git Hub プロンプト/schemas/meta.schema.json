{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Library Contract 2.0 metadata (strict starter schema)",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "prompt",
        "guide",
        "study-note",
        "report",
        "plan",
        "reference",
        "template",
        "project",
        "note",
        "other"
      ]
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "subcategory": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "archived"
      ]
    },
    "visibility": {
      "enum": [
        "public",
        "unlisted",
        "private"
      ]
    },
    "publish": {
      "type": "boolean"
    },
    "version": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "dates": {
      "type": "object",
      "properties": {
        "created": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "updated": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        }
      },
      "required": [
        "created",
        "updated"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "object",
      "properties": {
        "source": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "guide": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "preview": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "thumbnail": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "additional": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "source",
        "guide",
        "preview",
        "thumbnail",
        "additional"
      ],
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "properties": {
        "preview": {
          "type": "object",
          "properties": {
            "alt": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "width": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "height": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "format": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          },
          "required": [
            "alt",
            "width",
            "height",
            "bytes",
            "format"
          ],
          "additionalProperties": false
        },
        "thumbnail": {
          "type": "object",
          "properties": {
            "alt": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "width": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "height": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "format": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          },
          "required": [
            "alt",
            "width",
            "height",
            "bytes",
            "format"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "preview",
        "thumbnail"
      ],
      "additionalProperties": false
    },
    "search": {
      "type": "object",
      "properties": {
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "keywords"
      ],
      "additionalProperties": false
    },
    "relations": {
      "type": "object",
      "properties": {
        "parent_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "related_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "parent_id",
        "related_ids"
      ],
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "properties": {
        "source_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "guide_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "preview_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "thumbnail_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "guide_generated_from_source_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "preview_generated_from_source_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "thumbnail_generated_from_preview_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "source_sha256",
        "guide_sha256",
        "preview_sha256",
        "thumbnail_sha256",
        "guide_generated_from_source_sha256",
        "preview_generated_from_source_sha256",
        "thumbnail_generated_from_preview_sha256"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_origin": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "guide_generator_prompt_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "guide_generator_prompt_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "guide_generated_at": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "preview_generator_prompt_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "preview_generator_prompt_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "preview_generated_at": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        }
      },
      "required": [
        "source_origin",
        "guide_generator_prompt_id",
        "guide_generator_prompt_version",
        "guide_generated_at",
        "preview_generator_prompt_id",
        "preview_generator_prompt_version",
        "preview_generated_at"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "slug",
    "aliases",
    "title",
    "type",
    "category",
    "subcategory",
    "summary",
    "tags",
    "status",
    "visibility",
    "publish",
    "version",
    "language",
    "dates",
    "files",
    "media",
    "search",
    "relations",
    "integrity",
    "provenance"
  ],
  "additionalProperties": false
}
