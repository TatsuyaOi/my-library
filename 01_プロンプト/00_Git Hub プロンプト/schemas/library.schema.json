{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Library Contract 2.0 public index",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "build": {
      "type": "object",
      "properties": {
        "build_id": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "source_schema_version": {
          "const": "2.0"
        }
      },
      "required": [
        "build_id",
        "generated_at",
        "source_schema_version"
      ],
      "additionalProperties": false
    },
    "library": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "language"
      ],
      "additionalProperties": false
    },
    "facets": {
      "type": "object",
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "order": {
                "type": "integer"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "label",
              "order",
              "count"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "categories"
      ],
      "additionalProperties": false
    },
    "stats": {
      "type": "object",
      "properties": {
        "total_items": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_items": {
          "type": "integer",
          "minimum": 0
        },
        "stale_guides": {
          "type": "integer",
          "minimum": 0
        },
        "stale_previews": {
          "type": "integer",
          "minimum": 0
        },
        "stale_thumbnails": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "categories": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "total_items",
        "excluded_items",
        "stale_guides",
        "stale_previews",
        "stale_thumbnails",
        "warnings",
        "categories"
      ],
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "prompt",
              "guide",
              "study-note",
              "report",
              "plan",
              "reference",
              "template",
              "project",
              "note",
              "other"
            ]
          },
          "category": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "subcategory": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "version": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "dates": {
            "type": "object",
            "properties": {
              "created": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "string",
                    "format": "date-time"
                  }
                ]
              },
              "updated": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "string",
                    "format": "date-time"
                  }
                ]
              }
            },
            "required": [
              "created",
              "updated"
            ],
            "additionalProperties": false
          },
          "search": {
            "type": "object",
            "properties": {
              "keywords": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "keywords"
            ],
            "additionalProperties": false
          },
          "relations": {
            "type": "object",
            "properties": {
              "parent_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "related_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "parent_id",
              "related_ids"
            ],
            "additionalProperties": false
          },
          "paths": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "guide": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "preview": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "thumbnail": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              }
            },
            "required": [
              "source",
              "guide",
              "preview",
              "thumbnail"
            ],
            "additionalProperties": false
          },
          "media": {
            "type": "object",
            "properties": {
              "preview": {
                "type": "object",
                "properties": {
                  "alt": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  },
                  "width": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "height": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  }
                },
                "required": [
                  "alt",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              "thumbnail": {
                "type": "object",
                "properties": {
                  "alt": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  },
                  "width": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "height": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  }
                },
                "required": [
                  "alt",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "preview",
              "thumbnail"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "slug",
          "aliases",
          "title",
          "type",
          "category",
          "subcategory",
          "summary",
          "tags",
          "version",
          "language",
          "dates",
          "search",
          "relations",
          "paths",
          "media"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "build",
    "library",
    "facets",
    "stats",
    "items"
  ],
  "additionalProperties": false
}
