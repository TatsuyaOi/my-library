{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prompt Suite Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "suite_version",
    "contract_version",
    "released_on",
    "hash_policy",
    "scope",
    "components",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "suite_version": {
      "type": "string",
      "pattern": "^\\d+(?:\\.\\d+)+$"
    },
    "contract_version": {
      "const": "2.0"
    },
    "released_on": {
      "type": "string",
      "format": "date"
    },
    "hash_policy": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "order",
          "id",
          "path",
          "description",
          "version",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d+)+$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
